# ============================================================
# OnionGrade AI — Environment Variables Configuration
# ============================================================

# --- Secondary Vision AI Service (Server-side) ---
# Enable or disable the Gemini/OpenAI visual reasoning layer
VISION_AI_ENABLED=true

# Choose AI Vision provider: "gemini" or "openai"
VISION_PROVIDER=gemini

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, if using provider=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Vision AI Model Name (optional, defaults: gemini-1.5-flash / gpt-4o-mini)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Threshold & Cost Optimization
VISION_AI_CONFIDENCE_THRESHOLD=0.85
VISION_AI_ONLY_ON_DISAGREEMENT=true

# --- Frontend API Connection ---
# Set this on your Frontend Static Site (Vercel) pointing to your Render backend URL
VITE_AI_API_URL=https://your-onion-backend.onrender.com
